{
  "name": "@envoyage/browser",
  "version": "0.1.2",
  "description": "Thin, Workers-safe client for the Envoyage browser-driving engine. fetch + SSE only in the core path; drive a real remote browser (CF Browser Run or any Chrome), watch it live, and hand off to a human.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./launch": {
      "types": "./dist/launch.d.ts",
      "import": "./dist/launch.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "gen": "node scripts/gen-shared.mjs",
    "build": "npm run gen && tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build && rm -f dist/*.test.js dist/*.test.d.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Envoyage-Browsing/envoyage.git",
    "directory": "sdk"
  },
  "license": "MIT OR Apache-2.0",
  "keywords": [
    "browser",
    "automation",
    "cdp",
    "mcp",
    "ai-agent",
    "cloudflare-workers",
    "sse",
    "envoyage"
  ],
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.5.0"
  }
}
